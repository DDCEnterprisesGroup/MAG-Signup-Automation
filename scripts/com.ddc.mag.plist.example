<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.ddc.mag</string>
  <key>ProgramArguments</key><array><string>__PROJECT_ROOT__/scripts/magctl.sh</string><string>status</string></array>
  <key>WorkingDirectory</key><string>__PROJECT_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__PATH__</string>
    <key>MAG_DATA_DIR</key><string>__DATA_DIR__</string>
    <key>MAG_WORKBOOK_PATH</key><string>__WORKBOOK_PATH__</string>
  </dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__DATA_DIR__/logs/launchd.stdout.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/logs/launchd.stderr.log</string>
</dict></plist>
