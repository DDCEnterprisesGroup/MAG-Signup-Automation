{
  "manifest_version": 3,
  "name": "MAG — Human-Reviewed Autofill",
  "version": "1.1.0",
  "description": "Securely syncs approved MAG profiles and maps them to public-facing forms for human review and manual submission.",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "MAG Autofill Assistant"
  },
  "side_panel": { "default_path": "src/sidepanel/sidepanel.html" },
  "commands": {
    "autofill-active-profile": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Autofill the active MAG profile on the current page"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/constants.js",
        "src/core/normalize.js",
        "src/shared/dynamic-registry.js",
        "src/adapters/site-adapters.js",
        "src/core/field-detector.js",
        "src/core/field-classifier.js",
        "src/core/profile-mapper.js",
        "src/core/autofill-engine.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
